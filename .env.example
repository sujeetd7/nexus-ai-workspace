# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus_dev
MONGODB_URI=mongodb://localhost:27017/nexus_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Access tokens: Auth Service and Gateway MUST share JWT_ACCESS_SECRET.
JWT_ACCESS_SECRET=your-super-secret-jwt-key-change-in-production
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Service ports (defaults) — conflict-free W3 contract ──────────────────────
# gateway (@nexus/api-gateway) → 3000  (backend/gateway/api-gateway)
# auth-service                 → 3001
# workspace-service            → 3002
# user-service                 → 3003
# document-service             → 3004
# prompt-service               → 3005
# chat-service                 → 3006
# ai-service                   → 3007
# agent-service                → 3008
# ai-kernel                    → 3010  (Document owns 3004; Kernel moved to 3010)
#
# Duplicate Express gateway at backend/services/api-gateway is RETIRED.
#
# Upstream URLs for Gateway / agent→kernel / chat→prompt / prompt→ai:
AUTH_SERVICE_URL=http://localhost:3001
WORKSPACE_SERVICE_URL=http://localhost:3002
USER_SERVICE_URL=http://localhost:3003
DOCUMENT_SERVICE_URL=http://localhost:3004
PROMPT_SERVICE_URL=http://localhost:3005
CHAT_SERVICE_URL=http://localhost:3006
AI_SERVICE_URL=http://localhost:3007
AGENT_SERVICE_URL=http://localhost:3008
AI_KERNEL_URL=http://localhost:3010/api/v1

# ── AI / LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
GITHUB_MODELS_TOKEN=ghp_...
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com

# ── Vector DB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Storage ───────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=nexus-ai-uploads

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
