generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Prompt {
  id String @id @default(uuid())

  workspaceId String

  createdBy String

  name String

  description String?

  category String?

  isPublic Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  versions PromptVersion[]
}

model PromptVersion {
  id String @id @default(uuid())

  promptId String

  version Int

  systemPrompt String?

  userPrompt String?

  model String

  provider String?

  temperature Float @default(0.7)

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())

  prompt Prompt @relation(fields: [promptId], references: [id])

  executions       PromptExecution[]
  PromptEvaluation PromptEvaluation[]
}

model PromptExecution {
  id String @id @default(uuid())

  promptVersionId String

  input Json

  output Json?

  provider String?

  model String?

  status String @default("SUCCESS")

  tokens Int?

  latency Int?

  error String?

  createdAt DateTime @default(now())

  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id])
}

model PromptEvaluation {
  id String @id @default(uuid())

  promptVersionId String

  datasetName String

  evaluator String

  score Float

  totalCases Int

  passedCases Int

  failedCases Int

  createdAt DateTime @default(now())

  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id])

  results PromptEvaluationResult[]
}

model PromptEvaluationResult {
  id String @id @default(uuid())

  evaluationId String

  input Json

  expected Json?

  actual Json?

  passed Boolean

  score Float

  feedback String?

  latency Int?

  tokens Int?

  createdAt DateTime @default(now())

  evaluation PromptEvaluation @relation(fields: [evaluationId], references: [id])
}
